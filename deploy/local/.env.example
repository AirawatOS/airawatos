# Copy to `.env` and fill VAULT_TOKEN after the first `vault` boot (see docs/install-local.md, step 4).
# Vault auto-initialises on first boot and writes its root token into the vault_data volume; read it with:
#   docker compose up -d vault
#   docker compose exec vault sh -lc "sed -n 's/.*\"root_token\":\"\\([^\"]*\\)\".*/\\1/p' /vault/data/init.json"
# Paste the printed token below, then bring up the rest with `docker compose up -d`.
VAULT_TOKEN=
