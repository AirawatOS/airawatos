# AirawatOS reference services — ONE image, MANY services.
# Every reference service under platform-spec/reference/ is pure-stdlib Python (only `cryptography` is
# third-party). The compose file runs this image N times with a different `command:` per service
# (identity, app-host, scheduler, secrets, filestore, model-gateway, decision, workflow, automation,
# event-relay, notify). Build context = the workspace ROOT (it needs both reference/ and components/).
FROM python:3.11-slim
WORKDIR /app
# docker CLI (the runtime-manager service uses this image + the host docker socket to PLACE runtime
# containers), plus the light geo deps the in-process drivers/engines need (cell-indexer, coverage-qa,
# rainfall, weather-forecast, osm-roads/facilities) — h3, osmium, numpy, shapely. Heavy GEE/raster libs
# stay in the earth-observation runtime image, not here.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates libexpat1 zlib1g libbz2-1.0 \
 && apt-get install -y --no-install-recommends curl \
 && curl -fsSL "https://download.docker.com/linux/static/stable/x86_64/docker-27.3.1.tgz" -o /tmp/d.tgz \
 && tar -xzf /tmp/d.tgz -C /usr/local/bin --strip-components=1 docker/docker && rm /tmp/d.tgz \
 && apt-get purge -y curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir cryptography==43.0.3 h3 osmium numpy shapely pyproj requests pyyaml \
 && python3 -c "import h3, osmium, numpy, shapely; print('geo deps ok')"
# the reference services + the apps/components they serve (baked in — the demo image is self-contained)
COPY platform-spec/reference/ /app/reference/
COPY components/ /app/components/
ENV PYTHONUNBUFFERED=1
ENV BIND_HOST=0.0.0.0
# no ENTRYPOINT — compose provides the per-service command, e.g. ["python","reference/identity.py"]
